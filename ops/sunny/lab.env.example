# Copy to ops/sunny/lab.env for a private lab checkout.
# ops/sunny/lab.env is gitignored so real hosts, usernames, and key paths stay local.

# Remote WSL2 checkout and SSH route.
SUNNY_REPO_DIR=/home/ml-lab/Practice
SUNNY_SSH_TARGET=mlops@10.0.0.2
SUNNY_PROXY_TARGET=ubuntu@203.0.113.10
SUNNY_PROXY_KEY=$HOME/.ssh/example-proxy-key.pem
SUNNY_IDENTITY_FILE=$HOME/.ssh/id_ed25519

# Windows demo process roots used by ops/sunny/reinit-demo-stack.ps1.
SUNNY_LLAMA_ROOT='C:\ml-lab\llama.cpp'
SUNNY_MODELS_ROOT='C:\ml-lab\models'
SUNNY_VOICE_LAB_ROOT='C:\ml-lab\voice-lab'
SUNNY_WINDOWS_SCRIPTS_ROOT='C:\ml-lab'
